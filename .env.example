BOT_TOKEN=

# Обязательно: числовые ID пользователей через запятую. Узнать: /whoami.
# Пустой список закрывает ВСЕ команды сервера, включая просмотр логов.
ALLOWED_USER_IDS=
# Необязательно: разрешённые чаты. Пусто = любой чат, но только разрешённые пользователи.
ALLOWED_CHAT_IDS=-1002526628474

DOKPLOY_URL=https://dokploy.strand.moscow
DOKPLOY_API_KEY=
# Необязательно: URL для HTTP-проверок в /status. Ответы 2xx/3xx считаются успешными.
# HEALTH_URLS='{"immich":"https://photos.example.com","home":"http://192.168.0.70:8123"}'
HEALTH_URLS={}

# Метрики именно хоста, а не контейнера бота. На хосте нужен python3.
# Из контейнера можно использовать 192.168.0.70; снаружи — 109.94.1.253.
SERVER_SSH_HOST=
SERVER_SSH_USER=alex
SERVER_SSH_PORT=22
# Пути внутри контейнера. Ключ и known_hosts монтируются read-only.
SERVER_SSH_KEY_FILE=
SERVER_SSH_KNOWN_HOSTS_FILE=
SERVER_DISK_PATH=/
VPN_INTERFACE=tg-vpn

# Minecraft Java Edition, не Bedrock.
MINECRAFT_HOST=192.168.0.70
MINECRAFT_PORT=25565

HA_URL=http://192.168.0.70:8123
HA_TOKEN=
# Только явно разрешённые entity_id. Пример: sensor.temperature,binary_sensor.door
HA_ENTITIES=
# Только scene.* и script.*. Пример: scene.evening,script.close_house
HA_SCENES=

# Задания уже должны существовать в Dokploy. Идентификаторы берутся из Dokploy.
# kind: backup (БД/Compose) или volumeBackup (тома).
# BACKUP_TARGETS='[{"name":"immich-db","id":"BACKUP_ID","kind":"backup","max_age_hours":26}]'
BACKUP_TARGETS=[]
# Пусто = автоматические предупреждения выключены.
BACKUP_ALERT_CHAT_ID=
BACKUP_ALERT_THREAD_ID=
BACKUP_CHECK_SECONDS=3600
